Screen {
    background: $background;
    color: $foreground;
}

#app-shell {
    width: 100%;
    height: 1fr;
    align-horizontal: center;
}

#header-frame {
    width: 100%;
    height: 3;
}

#session-header {
    width: 100%;
    max-width: 108;
    height: 3;
    padding: 1 3 0 3;
    color: $codecraft-secondary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#conversation-pane {
    width: 100%;
    height: 1fr;
    padding: 0 2 1 2;
    align-horizontal: center;
    scrollbar-size-vertical: 1;
    scrollbar-color: $codecraft-scrollbar;
    scrollbar-background: $background;
}

MessageBlock,
ActivityBlock {
    width: 100%;
    max-width: 104;
    height: auto;
}

MessageBlock {
    margin-top: 1;
    padding: 0 3;
}

MessageBlock.user {
    color: $codecraft-strong;
}

MessageBlock.assistant {
    padding-left: 5;
    padding-right: 5;
    color: $foreground;
}

MessageBlock.error {
    padding-left: 5;
    padding-right: 5;
}

ActivityBlock {
    padding: 0 5;
    color: $codecraft-secondary;
}

ActivityBlock.activity-group-start {
    margin-top: 1;
}

#composer-frame {
    width: 100%;
    height: 5;
}

#composer {
    width: 100%;
    max-width: 108;
    height: 5;
    padding: 0 2 1 2;
}

#composer-frame.composer-menu-active,
#composer.composer-menu-active {
    height: 12;
}

#composer-frame.approval-active,
#composer.approval-active {
    height: 8;
}

#composer-menu {
    display: none;
    width: 100%;
    height: 7;
    border: solid $codecraft-border;
    border-bottom: none;
    background: $panel;
}

#composer-options {
    width: 100%;
    height: 7;
    padding: 0;
    border: none;
    background: transparent;
}

#composer-options:focus {
    border: none;
    background: transparent;
}

#composer-options > .option-list--option {
    height: 1;
    padding: 0 1;
    color: $codecraft-secondary;
}

#composer-options > .option-list--option-highlighted,
#composer-options:focus > .option-list--option-highlighted {
    background: $codecraft-selection;
    color: $codecraft-selection-text;
}

#approval-prompt {
    display: none;
    width: 100%;
    height: 6;
    padding: 0 1;
    border-top: solid $codecraft-border;
    background: $panel;
}

#approval-inline-title {
    width: 100%;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#approval-inline-detail {
    width: 100%;
    height: 2;
    color: $codecraft-muted;
}

#approval-options {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0;
    border: none;
    background: transparent;
}

#approval-options:focus {
    border: none;
    background: transparent;
}

#approval-options > .option-list--option {
    padding: 0 1;
    color: $codecraft-secondary;
}

#approval-options > .option-list--option-highlighted,
#approval-options:focus > .option-list--option-highlighted {
    background: $codecraft-selection;
    color: $codecraft-selection-text;
    text-style: bold;
}

#prompt-shell {
    width: 100%;
    height: 3;
    border: solid $codecraft-border;
    background: $surface;
}

#prompt-prefix {
    width: 3;
    height: 1;
    color: $primary;
    text-style: bold;
    content-align: center middle;
}

#prompt {
    width: 1fr;
    height: 1;
    padding: 0;
    border: none;
    background: transparent;
    color: $codecraft-strong;
}

#prompt:focus {
    border: none;
}

#prompt:disabled {
    color: $codecraft-faint;
}

#prompt > .input--placeholder {
    color: $codecraft-placeholder;
}

#prompt > .input--cursor {
    background: $primary;
    color: $codecraft-cursor-text;
}

#runtime-status {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: $codecraft-faint;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

SessionBrowserScreen,
TraceScreen {
    align: center middle;
    background: $codecraft-overlay;
}

#session-dialog,
#trace-dialog {
    padding: 1 2;
    background: $panel;
    border: solid $codecraft-border;
}

#session-title,
#trace-title {
    color: $codecraft-strong;
    text-style: bold;
}

#session-title {
    height: 2;
}

#session-actions {
    height: 2;
    align-horizontal: right;
    margin-top: 1;
}

#session-dialog {
    width: 96;
    max-width: 94%;
    height: 75%;
    min-height: 16;
}

#session-table,
#trace-events {
    background: $surface;
    color: $foreground;
}

#session-table {
    height: 1fr;
}

#session-table > .datatable--header,
#trace-events > .datatable--header {
    background: $codecraft-table-header;
    color: $codecraft-secondary;
    text-style: bold;
}

#session-table > .datatable--cursor,
#trace-events > .datatable--cursor {
    background: $codecraft-selection;
    color: $codecraft-selection-text;
}

#session-actions Button {
    width: 16;
    margin-left: 1;
}

Button.-style-flat {
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $codecraft-secondary;
    text-style: none;
}

Button.-style-flat:focus,
Button.-style-flat:hover {
    border: none;
    background: $codecraft-hover;
    color: $codecraft-strong;
    text-style: bold;
}

Button.-style-flat.-success {
    border: none;
    background: transparent;
    color: $codecraft-success;
}

#trace-dialog {
    width: 96%;
    height: 92%;
}

#trace-heading {
    height: 3;
}

#trace-title {
    width: 1fr;
    height: 3;
    content-align-vertical: middle;
}

#close-trace {
    width: 8;
}

#trace-metrics {
    height: 3;
    padding: 0 1;
    color: $codecraft-secondary;
}

#trace-events {
    height: 1fr;
    min-height: 6;
    margin-top: 1;
}

#trace-payload-title {
    height: 2;
    padding-top: 1;
    color: $codecraft-secondary;
    text-style: bold;
}

#trace-payload {
    height: 9;
    padding: 0 1;
    overflow-y: auto;
    background: $surface;
}
