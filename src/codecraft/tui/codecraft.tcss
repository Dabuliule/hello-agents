Screen {
    background: #0e0f11;
    color: #d8dbe0;
}

#app-shell {
    width: 100%;
    height: 1fr;
    align-horizontal: center;
}

#header-frame {
    width: 100%;
    height: 3;
}

#session-header {
    width: 100%;
    max-width: 108;
    height: 3;
    padding: 1 3 0 3;
    color: #a5abb3;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#conversation-pane {
    width: 100%;
    height: 1fr;
    padding: 0 2 1 2;
    align-horizontal: center;
    scrollbar-size-vertical: 1;
    scrollbar-color: #3a3f46;
    scrollbar-background: #0e0f11;
}

MessageBlock,
ActivityBlock {
    width: 100%;
    max-width: 104;
    height: auto;
}

MessageBlock {
    margin-top: 1;
    padding: 0 3;
}

MessageBlock.user {
    color: #f1f3f5;
}

MessageBlock.assistant {
    padding-left: 5;
    padding-right: 5;
    color: #d8dbe0;
}

MessageBlock.error {
    padding-left: 5;
    padding-right: 5;
}

ActivityBlock {
    padding: 0 5;
    color: #a5abb3;
}

ActivityBlock.activity-group-start {
    margin-top: 1;
}

#composer-frame {
    width: 100%;
    height: 5;
}

#composer {
    width: 100%;
    max-width: 108;
    height: 5;
    padding: 0 2 1 2;
}

#composer-frame.composer-menu-active,
#composer.composer-menu-active {
    height: 12;
}

#composer-frame.approval-active,
#composer.approval-active {
    height: 8;
}

#composer-menu {
    display: none;
    width: 100%;
    height: 7;
    border: solid #34383f;
    border-bottom: none;
    background: #121417;
}

#composer-options {
    width: 100%;
    height: 7;
    padding: 0;
    border: none;
    background: transparent;
}

#composer-options:focus {
    border: none;
    background: transparent;
}

#composer-options > .option-list--option {
    height: 1;
    padding: 0 1;
    color: #a5abb3;
}

#composer-options > .option-list--option-highlighted,
#composer-options:focus > .option-list--option-highlighted {
    background: #293044;
    color: #f1f3f5;
}

#approval-prompt {
    display: none;
    width: 100%;
    height: 6;
    padding: 0 1;
    border-top: solid #34383f;
    background: #121417;
}

#approval-inline-title {
    width: 100%;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#approval-inline-detail {
    width: 100%;
    height: 2;
    color: #8b919a;
}

#approval-options {
    width: 100%;
    height: 2;
    max-height: 2;
    padding: 0;
    border: none;
    background: transparent;
}

#approval-options:focus {
    border: none;
    background: transparent;
}

#approval-options > .option-list--option {
    padding: 0 1;
    color: #a5abb3;
}

#approval-options > .option-list--option-highlighted,
#approval-options:focus > .option-list--option-highlighted {
    background: #293044;
    color: #f1f3f5;
    text-style: bold;
}

#prompt-shell {
    width: 100%;
    height: 3;
    border: solid #34383f;
    background: #16181b;
}

#prompt-prefix {
    width: 3;
    height: 1;
    color: #8da2fb;
    text-style: bold;
    content-align: center middle;
}

#prompt {
    width: 1fr;
    height: 1;
    padding: 0;
    border: none;
    background: transparent;
    color: #f1f3f5;
}

#prompt:focus {
    border: none;
}

#prompt:disabled {
    color: #777e87;
}

#prompt > .input--placeholder {
    color: #666c74;
}

#prompt > .input--cursor {
    background: #8da2fb;
    color: #0e0f11;
}

#runtime-status {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: #777e87;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

SessionBrowserScreen,
TraceScreen {
    align: center middle;
    background: #000000 62%;
}

#session-dialog,
#trace-dialog {
    padding: 1 2;
    background: #15171a;
    border: solid #34383f;
}

#session-title,
#trace-title {
    color: #f1f3f5;
    text-style: bold;
}

#session-title {
    height: 2;
}

#session-actions {
    height: 2;
    align-horizontal: right;
    margin-top: 1;
}

#session-dialog {
    width: 96;
    max-width: 94%;
    height: 75%;
    min-height: 16;
}

#session-table,
#trace-events {
    background: #111315;
    color: #d8dbe0;
}

#session-table {
    height: 1fr;
}

#session-table > .datatable--header,
#trace-events > .datatable--header {
    background: #1c1f23;
    color: #a5abb3;
    text-style: bold;
}

#session-table > .datatable--cursor,
#trace-events > .datatable--cursor {
    background: #293044;
    color: #f1f3f5;
}

#session-actions Button {
    width: 16;
    margin-left: 1;
}

Button.-style-flat {
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
    background: transparent;
    color: #a5abb3;
    text-style: none;
}

Button.-style-flat:focus,
Button.-style-flat:hover {
    border: none;
    background: #343b4e;
    color: #f1f3f5;
    text-style: bold;
}

Button.-style-flat.-success {
    border: none;
    background: transparent;
    color: #79c99e;
}

#trace-dialog {
    width: 96%;
    height: 92%;
}

#trace-heading {
    height: 3;
}

#trace-title {
    width: 1fr;
    height: 3;
    content-align-vertical: middle;
}

#close-trace {
    width: 8;
}

#trace-metrics {
    height: 3;
    padding: 0 1;
    color: #a5abb3;
}

#trace-events {
    height: 1fr;
    min-height: 6;
    margin-top: 1;
}

#trace-payload-title {
    height: 2;
    padding-top: 1;
    color: #a5abb3;
    text-style: bold;
}

#trace-payload {
    height: 9;
    padding: 0 1;
    overflow-y: auto;
    background: #0e0f11;
}
